{
  "name": "termenbox-native",
  "version": "0.1.0",
  "private": true,
  "description": "Optional iOS, Android and desktop wrappers for the Termenbox client",
  "license": "MIT",
  "scripts": {
    "build:client": "pnpm --filter termenbox-client run build",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:electron": "cap sync @capacitor-community/electron",
    "sync:ios": "cap copy ios",
    "open:android": "cap open android",
    "open:electron": "cap open @capacitor-community/electron",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/electron": "5.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "^5.0.0"
  }
}

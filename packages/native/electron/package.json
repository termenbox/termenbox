{
  "name": "termenbox-electron",
  "version": "0.1.0",
  "description": "Termenbox desktop wrapper",
  "author": {
    "name": "Termenbox contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/termenbox/termenbox"
  },
  "license": "MIT",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json -p never"
  },
  "dependencies": {
    "@capacitor-community/electron": "5.0.1",
    "chokidar": "3.5.3",
    "electron-is-dev": "2.0.0",
    "electron-serve": "1.1.0",
    "electron-unhandled": "4.0.1",
    "electron-window-state": "5.0.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "capacitor",
    "electron"
  ]
}

{
  "id": "V30",
  "title": "T_human may exceed T_detach: the escalation waits while attached, the detach timer ends it once the client is away",
  "covers": [
    "TIMERS",
    "L2"
  ],
  "config": {
    "t_detach": 600,
    "t_human": 3600
  },
  "session": {
    "session_id": "sess-30",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "escalate"
    },
    {
      "do": "advance",
      "seconds": 2400,
      "then_cell": [
        "Att",
        "Pend"
      ]
    },
    {
      "do": "disconnect"
    },
    {
      "do": "advance",
      "seconds": 599,
      "then_cell": [
        "Det",
        "Pend"
      ]
    },
    {
      "do": "advance",
      "seconds": 1
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "HUMAN_PENDING",
      "DETACHMENT",
      "RESUME_PREPARED",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0,
    "last_event_payload": {
      "reason": "detach_timeout"
    }
  }
}

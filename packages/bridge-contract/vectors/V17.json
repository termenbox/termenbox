{
  "id": "V17",
  "title": "Simultaneous timeouts emit both events",
  "covers": [
    "L1",
    "L2"
  ],
  "config": {
    "t_detach": 100,
    "t_human": 100,
    "t_token": 50
  },
  "session": {
    "session_id": "sess-17",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "escalate"
    },
    {
      "do": "disconnect"
    },
    {
      "do": "advance",
      "seconds": 100
    },
    {
      "do": "tick"
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "HUMAN_PENDING",
      "DETACHMENT",
      "RESUME_PREPARED",
      "HUMAN_TIMEOUT",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0
  }
}

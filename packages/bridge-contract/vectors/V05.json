{
  "id": "V05",
  "title": "Expired token terminates on authenticated re-attach",
  "covers": [
    "T13",
    "I9"
  ],
  "session": {
    "session_id": "sess-05",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "disconnect"
    },
    {
      "do": "advance",
      "seconds": 900
    },
    {
      "do": "reattach",
      "error": true,
      "token": "current",
      "proof": "valid"
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "RESUME_TOKEN_EXPIRED",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0
  }
}

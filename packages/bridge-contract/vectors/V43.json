      "RESUME_PREPARED",
      "RESUME_STARTED",
      "RESUME_VERIFIED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "BRIDGE_RECOVERED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
